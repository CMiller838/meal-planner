{
  "_comment": "TEMPLATE: this file is the shared/checked-in config (settings.local.json is gitignored by convention and won't travel with the repo -- see README). Fill in the sandbox allowlist for this project's package manager/network needs; delete that block entirely if defaults are fine.",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": []
    },
    "network": {
      "allowedDomains": []
    }
  },
  "permissions": {
    "allow": [
      "Bash(git status *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env.local)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "ask": [
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "strategic-compact": "off",
    "verification-loop": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Before spawning: is an agent already running/completed on this task? Check ListAgents / conversation for an agentId, and use SendMessage to resume it instead of a fresh Agent call — see .claude/rules/agent-resume.md.' >&2; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-lint.sh"
          }
        ]
      }
    ]
  }
}
